@model FuelFlowQueueLab.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="fade-in-up">
    <!-- Hero Section -->
    <div class="mb-5 pb-3 border-bottom">
        <h2 class="fw-bold d-flex align-items-center gap-2 text-navy-900 mb-2">
            <i class="bi bi-droplet-fill text-amber fs-3"></i> Petrol Pump Simulation
        </h2>
        <p class="text-muted fs-5">What would you like to open?</p>
    </div>

    <!-- Main Navigation Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <a href="~/Simulation/Index" class="text-decoration-none">
                <div class="card glass-card h-100 p-4 text-center border-0">
                    <div class="card-body">
                        <div class="bg-navy-100 text-navy-800 rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                            <i class="bi bi-calculator fs-1"></i>
                        </div>
                        <h3 class="h4 fw-bold text-dark mb-3">Queueing Calculator</h3>
                        <p class="text-muted mb-0">
                            Instant formula-based results: M/M/1, M/M/s, M/G/1, M/G/s, G/G/1, G/G/s
                        </p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a href="~/Simulator/Index" class="text-decoration-none">
                <div class="card glass-card h-100 p-4 text-center border-0">
                    <div class="card-body">
                        <div class="bg-amber-100 text-amber-600 rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                            <i class="bi bi-play-circle-fill fs-1"></i>
                        </div>
                        <h3 class="h4 fw-bold text-dark mb-3">Simulator</h3>
                        <p class="text-muted mb-0">
                            Event-by-event Discrete Event Simulation of the petrol pump queue
                        </p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Project Team Section -->
    <div class="card glass-card border-0 mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4 d-flex align-items-center gap-2 text-navy-800">
                <i class="bi bi-people-fill text-amber"></i> Project Team
            </h4>
            
            <div class="row g-3">
                @foreach (var member in Model.TeamMembers)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="d-flex align-items-center p-3 border rounded-3 bg-white hover-shadow transition">
                            <div class="bg-navy text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark lh-1 mb-1">@member.Name</div>
                                <div class="small text-muted font-monospace">@member.RollNumber</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
