<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FuelFlow Queue Lab</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex flex-column min-vh-100">
        
        <!-- HEADER -->
        <header class="app-header">
            <div class="container-fluid d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="logo-box">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-droplet-fill text-amber" viewBox="0 0 16 16">
                          <path d="M8 16a6 6 0 0 0 6-6c0-1.655-1.122-2.904-2.432-4.362C10.254 4.176 8.75 2.503 8 0c0 0-6 5.686-6 10a6 6 0 0 0 6 6M6.646 4.646l.708.708c-.29.29-1.128 1.311-1.128 2.5a.5.5 0 0 1-1 0c0-1.636 1.13-3.056 1.42-3.208"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold text-white header-title">Petrol Pump Simulation</h1>
                        <p class="mb-0 text-white-50 small header-subtitle">
                            Shell Petrol Pump Maskan Rd, Karachi | DCS-UOK BSCS-VI | Dr. Shaista Rais
                        </p>                    
                        </div>
                </div>
                
                <!-- Navbar Links -->
                <nav class="d-none d-md-flex gap-4">
                    <a href="~/Simulation/Index" class="nav-link text-white-50 nav-item-hover"><i class="bi bi-calculator me-1"></i> Calculator</a>
                    <a href="~/Simulator/Index" class="nav-link text-white-50 nav-item-hover"><i class="bi bi-play-circle me-1"></i> Simulator</a>
                    <a href="~/" class="nav-link text-white-50 nav-item-hover"><i class="bi bi-house me-1"></i> Home</a>
                </nav>
                
                <!-- Mobile Menu Button -->
                <button class="btn btn-link text-white d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
                    <i class="bi bi-list fs-2"></i>
                </button>
            </div>
        </header>

        <div class="d-flex flex-grow-1 overflow-hidden main-wrapper">
            <!-- SIDEBAR -->
            <partial name="_Sidebar" />

            <!-- MAIN CONTENT -->
            <main class="flex-grow-1 overflow-auto bg-light p-4 main-content">
                <div class="container-fluid max-w-1200 mx-auto">
                    @RenderBody()
                </div>
            </main>
        </div>
        
        <!-- FOOTER -->
        <footer class="app-footer mt-auto py-3 text-center border-top">
            <div class="container">
                <span class="text-muted small">
                    Petrol Pump Simulation | Calculator + Discrete Event Simulator | DCS &ndash; University of Karachi | Dr. Shaista Rais
                </span>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
